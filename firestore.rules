rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId) && isValidProfile(request.resource.data);
      allow delete: if false;

      function isValidProfile(data) {
        return data.keys().hasOnly(['displayName', 'bio', 'avatarUrl', 'updatedAt'])
          && data.displayName is string
          && data.displayName.trim().size() >= 2
          && data.displayName.size() <= 30
          && data.bio is string
          && data.bio.size() <= 160
          && (data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1024))
          && data.updatedAt == request.time;
      }
    }
  }
}
