rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) && isValidProfile(request.resource.data);

      function isOwnAvatarUrl(url) {
        return url is string
          && url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/users%2F' + userId + '%2Favatar_[0-9]+[.](jpg|jpeg|png|webp|heic)[?].*');
      }

      function isValidProfile(data) {
        return data.keys().hasOnly(['displayName', 'bio', 'avatarUrl', 'updatedAt'])
          && data.displayName is string
          && data.displayName.trim().size() >= 2
          && data.displayName.size() <= 30
          && data.bio is string
          && data.bio.size() <= 160
          && (data.avatarUrl == null || isOwnAvatarUrl(data.avatarUrl))
          && data.updatedAt == request.time;
      }
    }

    // Spots : lecture seule côté client ; geohash et compteurs sont écrits par les Cloud Functions
    match /spots/{spotId} {
      allow read: if request.auth != null;

      match /ratings/{ratingId} {
        allow read: if request.auth != null;
        // Une note par personne (id = uid) ; l'auteur du spot ne peut pas noter ; pas de delete
        allow create, update: if isOwner(ratingId)
          && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
          && request.resource.data.keys().hasAll(['value', 'updatedAt'])
          && request.resource.data.value is int
          && request.resource.data.value >= 1
          && request.resource.data.value <= 5
          && request.resource.data.updatedAt == request.time
          && get(/databases/$(database)/documents/spots/$(spotId)).data.authorId != request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if exists(/databases/$(database)/documents/spots/$(spotId))
          && isOwner(request.resource.data.authorId)
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['authorId', 'text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.trim().size() >= 1
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(resource.data.authorId);
      }
    }
  }
}
