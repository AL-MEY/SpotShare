{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "lib",
    "rootDir": "."
  },
  "include": [
    "src",
    "test"
  ]
}
